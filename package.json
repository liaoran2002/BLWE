{
  "name": "BiLiMusicVideo-desktop",
  "version": "1.0.0",
  "author": "liaoran2002",
  "description": "BLMV：把音乐歌单变成B站MV视频播放列表的桌面播放器。",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "chcp 65001 && electron-vite dev",
    "dev:wall": "chcp 65001 && electron-vite dev -- --wallpaper-mode",
    "build": "npm run typecheck && electron-vite build",
    "build:only": "chcp 65001 && electron-vite build",
    "preview": "chcp 65001 && electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "protect": "node scripts/protect.mjs",
    "build:protected": "npm run build:only && npm run protect",
    "pack": "npm run build:protected && electron-builder --dir",
    "dist": "npm run build:protected && electron-builder"
  },
  "dependencies": {
    "bytenode": "^1.7.0",
    "electron-as-wallpaper": "^2.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@vitejs/plugin-vue": "^6.0.7",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0-beta.1",
    "element-plus": "^2.14.2",
    "javascript-obfuscator": "^5.9.0",
    "pinia": "^3.0.4",
    "typescript": "^5.9.3",
    "vite": "^8.0.16",
    "vue": "^3.5.38",
    "vue-tsc": "^3.3.11"
  },
  "build": {
    "appId": "com.bilibili.musicvideo",
    "productName": "BLMV",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "public",
        "to": "icons",
        "filter": [
          "bili.ico"
        ]
      }
    ],
    "asarUnpack": [
      "**/node_modules/electron-as-wallpaper/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/bili.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "removeDefaultUninstallWelcomePage": false,
      "deleteAppDataOnUninstall": true
    }
  }
}
